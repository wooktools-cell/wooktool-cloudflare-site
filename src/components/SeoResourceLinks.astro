---
const {
  eyebrow = "Sourcing resources",
  title = "Related sourcing resources",
  description = "Continue through related product, customization, quality, and sourcing pages prepared for B2B buyers.",
  clusters = []
} = Astro.props;
---

{clusters.length > 0 && (
  <section class="section soft">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="eyebrow">{eyebrow}</p>
          <h2>{title}</h2>
        </div>
        <p>{description}</p>
      </div>
      <div class="grid three">
        {clusters.map((cluster) => (
          <article class="info-card">
            <h3>{cluster.title}</h3>
            <p>{cluster.text}</p>
            <ul class="link-list">
              {cluster.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

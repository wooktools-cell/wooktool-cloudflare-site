---
import { site } from "../siteData.js";

const { ga4Id = "", clarityId = "" } = site.analytics || {};
const { metaPixelId = "" } = site.analytics || {};
---

{ga4Id && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){window.dataLayer.push(arguments);};
      window.gtag("js", new Date());
      window.gtag("config", ga4Id);
    </script>
  </>
)}

{clarityId && (
  <script define:vars={{ clarityId }}>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", clarityId);
  </script>
)}

{metaPixelId && (
  <>
    <script define:vars={{ metaPixelId }}>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version="2.0";
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,"script",
      "https://connect.facebook.net/en_US/fbevents.js");
      fbq("init", metaPixelId);
      fbq("track", "PageView");
    </script>
    <noscript><img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`} /></noscript>
  </>
)}

<script>
  const rfqHandoffStorageKey = "wooktool_rfq_handoff_v1";
  const rfqHandoffMaxAgeMs = 30 * 60 * 1000;

  const trackEvent = (eventName, params = {}) => {
    if (!eventName) return;
    if (typeof window.gtag === "function") {
      window.gtag("event", eventName, params);
    }
    if (typeof window.clarity === "function") {
      window.clarity("event", eventName);
    }
    if (typeof window.fbq === "function") {
      window.fbq("trackCustom", eventName, params);
    }
  };

  const ensureRfqEventId = (form) => {
    const field = form.querySelector('[data-rfq-attribution="rfq_event_id"]');
    if (!(field instanceof HTMLInputElement)) return "";
    if (!field.value) {
      field.value = typeof window.crypto?.randomUUID === "function"
        ? window.crypto.randomUUID()
        : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    }
    return field.value;
  };

  const saveRfqHandoff = (form) => {
    try {
      const eventId = ensureRfqEventId(form);
      if (!eventId) return;
      window.sessionStorage.setItem(rfqHandoffStorageKey, JSON.stringify({
        event_id: eventId,
        form_id: form.id || form.getAttribute("data-track") || "rfq",
        source_page: `${window.location.pathname}${window.location.search}`,
        submitted_at: Date.now()
      }));
    } catch {
      // Storage or privacy settings must never block the native form handoff.
    }
  };

  const consumeRfqHandoff = () => {
    if (window.location.pathname !== "/contact/thank-you/") return null;
    try {
      const stored = window.sessionStorage.getItem(rfqHandoffStorageKey);
      if (!stored) return null;
      window.sessionStorage.removeItem(rfqHandoffStorageKey);
      const handoff = JSON.parse(stored);
      const age = Date.now() - Number(handoff?.submitted_at || 0);
      if (!handoff?.event_id || age < 0 || age > rfqHandoffMaxAgeMs) return null;
      return handoff;
    } catch {
      try {
        window.sessionStorage.removeItem(rfqHandoffStorageKey);
      } catch {
        // Ignore storage restrictions on the thank-you page.
      }
      return null;
    }
  };

  const confirmedHandoff = consumeRfqHandoff();
  if (confirmedHandoff) {
    trackEvent("rfq_submit_success", {
      event_id: confirmedHandoff.event_id,
      form_id: confirmedHandoff.form_id,
      source_page: confirmedHandoff.source_page,
      page_path: window.location.pathname,
      method: "thank_you_redirect",
      confirmation_level: "browser_redirect"
    });
  }

  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target.closest("[data-track]") : null;
    if (!target || target instanceof HTMLFormElement) return;
    const eventName = target.getAttribute("data-track");
    const params = {
      page_path: window.location.pathname
    };
    trackEvent(eventName, params);

    if (eventName === "whatsapp_click" || eventName === "email_click") {
      trackEvent("contact_click", { method: eventName === "whatsapp_click" ? "whatsapp" : "email", page_path: window.location.pathname });
    }
  });

  const startedForms = new WeakSet();
  document.addEventListener("focusin", (event) => {
    const form = event.target instanceof Element ? event.target.closest("form[data-track]") : null;
    if (!form || startedForms.has(form)) return;
    startedForms.add(form);
    trackEvent("rfq_start", { form_id: form.id || form.getAttribute("data-track"), page_path: window.location.pathname });
  });

  document.addEventListener("submit", (event) => {
    const form = event.target instanceof HTMLFormElement ? event.target.closest("[data-track]") : null;
    if (!form) return;
    // Defer until all form validation/preview handlers have run.
    queueMicrotask(() => {
      if (event.defaultPrevented) return;
      saveRfqHandoff(form);
      trackEvent("rfq_submit_attempt", {
        form_id: form.id || form.getAttribute("data-track") || "rfq",
        page_path: window.location.pathname,
        method: "native_form_handoff",
        product_line_count: form.closest("aside")?.querySelectorAll("[data-line]").length || 0
      });
    });
  });
</script>

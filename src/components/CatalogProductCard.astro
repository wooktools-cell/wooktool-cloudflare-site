---
import imageVariants from "../image-variants.json";
const { product } = Astro.props;
const rfqHref = `/contact/?product=${encodeURIComponent(product.slug)}#rfq-form`;
const thumbnail = imageVariants[product.image]?.thumbnail || product.image;
---

<article class="catalog-card">
  <a class="catalog-media-link" href={`/products/${product.slug}/`} aria-label={`View ${product.title}`}>
    <img class="catalog-product-image" src={thumbnail} alt={`${product.title} product image on white background`} width="480" height="480" loading="lazy" decoding="async" />
  </a>
  <div>
    <p class="catalog-category">{product.category}</p>
    <h2><a href={`/products/${product.slug}/`}>{product.title}</a></h2>
    <p>{product.summary}</p>
    <div class="catalog-actions">
      <a class="catalog-detail-link" href={`/products/${product.slug}/`}>View Details</a>
      <a class="catalog-rfq-link" href={rfqHref} data-track="catalog_product_rfq_click">Request Quote</a>
    </div>
  </div>
</article>

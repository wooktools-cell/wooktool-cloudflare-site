---
import { site } from "../siteData.js";
---

<form
  class="contact-form"
  action={`https://formsubmit.co/${site.email}`}
  method="post"
  data-track="form_submit"
>
  <input type="hidden" name="_subject" value="New WOOKTOOL RFQ from website" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_next" value={`${site.domain}/contact/thank-you/`} />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="lead_source" value="website" data-source-field="lead_source" />
  <input type="hidden" name="utm_source" data-source-field="utm_source" />
  <input type="hidden" name="utm_medium" data-source-field="utm_medium" />
  <input type="hidden" name="utm_campaign" data-source-field="utm_campaign" />
  <input type="hidden" name="utm_content" data-source-field="utm_content" />
  <input type="hidden" name="utm_term" data-source-field="utm_term" />
  <input class="form-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" />
  <div class="form-grid">
    <label>
      Name
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label>
      Email
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <label>
      Country
      <input type="text" name="country" autocomplete="country-name" />
    </label>
    <label>
      Product Interest
      <select name="product_interest" required>
        <option value="">Select product type</option>
        <option>Tape Measures</option>
        <option>Custom Tape Measure</option>
        <option>Utility Knives</option>
        <option>Screwdriver Sets</option>
        <option>OEM/ODM Hand Tools</option>
      </select>
    </label>
    <label>
      Estimated Quantity
      <input type="text" name="estimated_quantity" />
    </label>
  </div>
  <label>
    Message
    <textarea name="message" rows="7" required></textarea>
  </label>
  <button class="button button-primary" type="submit" data-track="contact_form_submit_click">Send Your RFQ to wooktools</button>
  <p class="form-note">Your RFQ will be sent to <a href={`mailto:${site.email}`} data-track="email_click">{site.email}</a>. Prefer direct contact? Message us on <a href={site.whatsappUrl} data-track="whatsapp_click">WhatsApp</a> or follow <a href={site.facebookUrl} data-track="facebook_contact_form_click">WOOKTOOL on Facebook</a>.</p>
</form>

<script>
  const params = new URLSearchParams(window.location.search);
  const sourceFields = document.querySelectorAll("[data-source-field]");

  sourceFields.forEach((field) => {
    if (!(field instanceof HTMLInputElement)) return;
    const fieldName = field.getAttribute("data-source-field");
    if (!fieldName) return;
    const value = params.get(fieldName);
    if (value) field.value = value;
  });

  const leadSource = document.querySelector("[data-source-field='lead_source']");
  if (leadSource instanceof HTMLInputElement) {
    leadSource.value = params.get("utm_source") || document.referrer || "website";
  }
</script>

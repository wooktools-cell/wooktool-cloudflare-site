---
import { site } from "../siteData.js";
import RfqAttributionFields from "./RfqAttributionFields.astro";
---

<form
  class="contact-form"
  action={site.formSubmitEndpoint}
  method="post"
  data-track="form_submit"
  data-rfq-form
>
  <input type="hidden" name="_subject" value="New WOOKTOOL RFQ from website" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_next" value={`${site.domain}/contact/thank-you/`} />
  <input type="hidden" name="_captcha" value="false" />
  <RfqAttributionFields formType="contact_form" />
  <input class="form-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" />
  <div class="form-grid">
    <label>
      Name
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label>
      Email
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <label>
      Country
      <input type="text" name="country" autocomplete="country-name" />
    </label>
    <label>
      Product Interest
      <input type="text" name="product_interest" list="product-interest-options" aria-describedby="product-interest-note" required />
      <span class="field-note" id="product-interest-note">Examples: tape measures, utility knives, screwdriver sets, OEM/ODM hand tools.</span>
      <datalist id="product-interest-options">
        <option value="Tape Measures"></option>
        <option value="Custom Tape Measure"></option>
        <option value="Utility Knives"></option>
        <option value="Screwdriver Sets"></option>
        <option value="OEM/ODM Hand Tools"></option>
      </datalist>
    </label>
    <label>
      Estimated Quantity
      <input type="text" name="estimated_quantity" />
    </label>
  </div>
  <label>
    Message
    <textarea name="message" rows="7" required></textarea>
  </label>
  <button class="button button-primary" type="submit" data-track="contact_form_submit_click">Send Your RFQ to wooktools</button>
  <p class="form-note">Your RFQ will be sent to <a href={`mailto:${site.email}`} data-track="email_click">{site.email}</a>. Prefer direct contact? Message us on <a href={site.whatsappUrl} data-track="whatsapp_click">WhatsApp</a> or follow <a href={site.facebookUrl} data-track="facebook_contact_form_click">WOOKTOOL on Facebook</a>.</p>
</form>

<script>
  const params = new URLSearchParams(window.location.search);
  const productInterest = document.querySelector("[name='product_interest']");
  const productParam = params.get("product");

  const formatProductName = (value) =>
    value
      .replace(/[-_]+/g, " ")
      .replace(/\b\w/g, (letter) => letter.toUpperCase());

  if (productParam && productInterest instanceof HTMLInputElement) {
    productInterest.value = formatProductName(productParam);
  }
</script>

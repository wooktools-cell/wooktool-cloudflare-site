---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import CompactRFQ from "../../components/CompactRFQ.astro";
import FAQ from "../../components/FAQ.astro";
import CatalogProductCard from "../../components/CatalogProductCard.astro";
import { catalogProducts, productRoutes, site } from "../../siteData.js";
import { faqSchema } from "../../schema.js";

export function getStaticPaths() {
  return productRoutes.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;
const relatedProducts = catalogProducts
  .filter((item) => item.category === product.category && item.slug !== product.slug)
  .slice(0, 3);
const relatedHeadingByCategory = {
  "Tape Measures": "More tape measure options",
  "Utility Knives": "More utility knife options",
  "Screwdriver Sets": "More screwdriver set options"
};
const productUrl = new URL(`/products/${product.slug}/`, site.domain).toString();
const categoryPathByName = {
  "Tape Measures": "/tape-measures/",
  "Utility Knives": "/utility-knives/",
  "Screwdriver Sets": "/screwdriver-sets/"
};
const categoryPath = categoryPathByName[product.category] || "/products/";
const customizationPath =
  product.category === "Tape Measures" ? "/custom-tape-measure/" : "/oem-odm/";
const customizationLabel =
  product.category === "Tape Measures" ? "Customize This Tape Measure" : "Customize This Product";
const productSeoTitle =
  product.metaTitle || `${product.title} Supplier China | OEM WOOKTOOL`;
const productSeoDescription =
  product.metaDescription ||
  `Source ${product.title} from WOOKTOOL with OEM logo, packaging, QC inspection, flexible MOQ, and export support for B2B buyers.`;
const categoryLabel = product.category?.toLowerCase() || "hand tools";
const buyerText = product.targetBuyers || "importers, distributors, wholesalers, and private-label brands";
const packagingText =
  product.specs.Packaging ||
  "Blister card, color box, display box, hang card, bulk pack, export carton, buyer barcode, and carton mark";
const packagingOptions = packagingText
  .split(",")
  .map((item) => item.trim())
  .filter(Boolean)
  .slice(0, 8);
const qualitySummary =
  product.quality.length > 0
    ? product.quality.slice(0, 3).join(", ").toLowerCase()
    : "material, function, appearance, packaging, and carton condition";
const productIntroParagraphs =
  product.introduction ||
  [
    `${product.title} is a WOOKTOOL ${categoryLabel} option supplied by wooktools for B2B buyers who need reliable factory production, private-label support, and practical export packaging. The product is suitable for ${buyerText.toLowerCase()} that want a clear specification, repeatable quality, and responsive sourcing communication before placing a bulk order.`,
    `For OEM and ODM projects, buyers can discuss logo position, product color, market packaging, barcode labels, carton marks, and target price with the wooktools team. We can help review whether an existing WOOKTOOL model, adjusted specification, or custom packaging direction is most suitable for your sales channel.`,
    `Before quotation, send your estimated quantity, target market, preferred packaging, logo file, delivery schedule, and any reference product photos. This helps us confirm material selection, sample direction, inspection points, and bulk production feasibility more quickly. Each order can be reviewed around function, appearance, packaging, and pre-shipment quality control.`
  ];
const productFaq =
  product.faq || [
    {
      question: `Can wooktools customize ${product.title}?`,
      answer: `${product.specs.Customization || "Yes. Logo, color, packaging, barcode, carton mark, and private-label details can be customized based on the selected model and order quantity."}`
    },
    {
      question: `What packaging options are available for ${product.title}?`,
      answer: packagingText
    },
    {
      question: `What is the MOQ for this product?`,
      answer: product.specs.MOQ || "MOQ depends on the selected model, customization level, and packaging requirement. wooktools can review a suitable option after receiving your RFQ details."
    },
    {
      question: "Can I request samples before bulk production?",
      answer: "Yes. Samples can be arranged after confirming product specification, logo method, packaging direction, and target market requirement."
    },
    {
      question: "What quality points are checked before shipment?",
      answer: `Common checks include ${qualitySummary}, plus packaging and carton confirmation before shipment.`
    },
    {
      question: "Who is this product suitable for?",
      answer: `${product.title} is suitable for ${buyerText.toLowerCase()}.`
    }
  ];
const internalLinks = [
  {
    href: categoryPath,
    label:
      product.category === "Tape Measures"
        ? "tape measure manufacturer"
        : product.category === "Utility Knives"
          ? "utility knife manufacturer"
          : "screwdriver set supplier"
  },
  { href: "/oem-odm/", label: "OEM hand tools supplier" },
  {
    href: "/quality-control/",
    label: product.category === "Tape Measures" ? "tape measure quality control" : "hand tools quality control"
  },
  { href: "/contact/#product-rfq", label: "Request Product Quote" }
];
if (product.category === "Tape Measures") {
  internalLinks.splice(1, 0, { href: "/custom-tape-measure/", label: "custom tape measure supplier" });
}
const imageUrls = [product.image, ...(product.detailImages || [])].map((image) =>
  new URL(image, site.domain).toString()
);
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.title,
  description: product.summary,
  image: imageUrls,
  url: productUrl,
  brand: {
    "@type": "Brand",
    name: site.name
  },
  manufacturer: {
    "@type": "Organization",
    name: site.companyName,
    url: site.domain
  },
  category: product.category,
  offers: {
    "@type": "Offer",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: productUrl
  },
  additionalProperty: Object.entries(product.specs).map(([name, value]) => ({
    "@type": "PropertyValue",
    name,
    value
  }))
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", site.domain).toString()
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Products",
      item: new URL("/products/", site.domain).toString()
    },
    {
      "@type": "ListItem",
      position: 3,
      name: product.category,
      item: new URL(categoryPath, site.domain).toString()
    },
    {
      "@type": "ListItem",
      position: 4,
      name: product.title,
      item: productUrl
    }
  ]
};
const productPageSchema = [productSchema, breadcrumbSchema, faqSchema(productFaq)];
---

<BaseLayout
  title={productSeoTitle}
  description={productSeoDescription}
  path={`/products/${product.slug}/`}
  image={product.image}
  type="product"
  schema={productPageSchema}
>
  <section class="page-intro">
    <div>
      <p class="eyebrow">{product.category}</p>
      <h1>{product.title}</h1>
      <p>{product.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner product-detail-layout">
      <img class="product-square-image" src={product.image} alt={`${product.title} main product image on white background`} width="1000" height="1000" />
      <div>
        <p class="eyebrow">Product details</p>
        <h2>Specifications</h2>
        <table class="spec-table">
          <tbody>
            {Object.entries(product.specs).map(([label, value]) => (
              <tr><th>{label}</th><td>{value}</td></tr>
            ))}
          </tbody>
        </table>
        <div class="product-action-row">
          <a class="button button-primary" href="#product-rfq" data-track="product_detail_rfq_click">Request Product Quote</a>
          <a class="button button-secondary" href={customizationPath} data-track="product_detail_custom_click">{customizationLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="section-inner content-grid">
      <div class="content-copy">
        <p class="eyebrow">Sourcing overview</p>
        <h2>{product.title} for B2B sourcing programs</h2>
        {productIntroParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <article class="info-card">
        <h3>Internal buyer links</h3>
        <ul class="link-list">
          {internalLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </article>
    </div>
  </section>

  {product.detailImages?.length > 0 && (
    <section class="section soft">
      <div class="section-inner">
        <div class="section-header">
          <div>
            <p class="eyebrow">Product photos</p>
            <h2>Main details and packaging views</h2>
          </div>
          <p>Each product page keeps one main image and two detail images to balance clear product presentation with fast page loading.</p>
        </div>
        <div class="product-gallery">
          {product.detailImages.map((image, index) => (
            <img src={image} alt={`${product.title} detail view ${index + 1} for OEM buyers`} width="1000" height="1000" loading="lazy" />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-inner grid two">
      <div>
        <p class="eyebrow">Quality control</p>
        <h2>Quality points for this product</h2>
        <p>WOOKTOOL supports material checks, assembly inspection, functional testing, appearance review, and packaging inspection before shipment.</p>
      </div>
      <ul class="check-list">
        {product.quality.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section soft">
    <div class="section-inner grid three">
      <article class="info-card">
        <h3>Key selling points</h3>
        <ul class="mini-list">{product.sellingPoints.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article class="info-card"><h3>Customization</h3><p>{product.specs.Customization || "Logo, color, packaging, barcode, carton mark, and private-label details can be customized for this product."}</p></article>
      <article class="info-card"><h3>Target buyers</h3><p>{product.targetBuyers}</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="eyebrow">Packaging options</p>
          <h2>Export-ready packaging for this product</h2>
        </div>
        <p>Packaging can be reviewed around retail display, barcode needs, carton marks, shipping protection, and the buyer's target sales channel.</p>
      </div>
      <div class="packaging-grid">
        {packagingOptions.map((option, index) => (
          <article class="packaging-card">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{option}</h3>
            <p>wooktools can confirm artwork, label, quantity, and carton requirements for this packaging direction during RFQ review.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="section-inner">
      <CompactRFQ
        title={`Request Product Quote for ${product.title}`}
        productInterest={product.title}
        source={`product-${product.slug}`}
      />
    </div>
  </section>

  <FAQ items={productFaq} title={`${product.title} FAQ`} />

  {relatedProducts.length > 0 && (
    <section class="section">
      <div class="section-inner">
        <div class="section-header">
          <div>
            <p class="eyebrow">Related products</p>
            <h2>{relatedHeadingByCategory[product.category] || `More ${product.category.toLowerCase()} options`}</h2>
          </div>
          <p>Compare nearby product entries for different specifications, packaging options, and custom branding directions.</p>
        </div>
        <div class="catalog-grid compact">
          {relatedProducts.map((item) => <CatalogProductCard product={item} />)}
        </div>
      </div>
    </section>
  )}

  <CTA
    title={`Request a quote for ${product.title}`}
    text="Send your target quantity, logo, packaging, and delivery requirements. WOOKTOOL will review quotation and customization options for this product."
    primaryLabel="Send Product RFQ"
    primaryHref="/contact/#rfq-form"
    secondaryLabel={customizationLabel}
    secondaryHref={customizationPath}
  />
</BaseLayout>

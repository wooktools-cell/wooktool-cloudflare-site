---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema } from "../schema.js";

const path = "/custom-tool-projects/";
const schema = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "OEM/ODM", path: "/oem-odm/" },
  { name: "Custom hand tool projects", path }
]);
---
<BaseLayout title="Custom Hand Tool Projects: Private Label & New Tooling | WOOKTOOL" description="See how WOOKTOOL customized a folding utility knife and developed a gift tape measure, from logo artwork and mold design to samples, packaging and inspection." path={path} schema={schema} image="/images/custom-projects/gift-tape-measure.webp">
<div class="project-story">
<div class="intro"><h1>Custom hand tool projects</h1><p>Start with a tool from our range or bring a concept of your own. These two projects show what changes when the brief calls for new branding, retail packaging or custom tooling.</p></div>
<nav aria-label="Choose a project type"><a href="#existing">Customize an existing tool ↓</a><a href="#development">Develop a new product ↓</a></nav>
<section class="case" id="existing"><div class="lead"><div><span class="tag">Existing tooling</span><h2>A folding utility knife with custom branding</h2><p>The project started with a customer logo and an existing knife design. Logo placement, print artwork and color samples let the buyer review how the branded product would look.</p><p class="next"><a href="/products/folding-utility-knife/">View the folding utility knife</a></p><p class="next"><a href="/blog/private-label-folding-utility-knife-case-study/">Read the private-label knife case study</a></p></div></div>
<div class="gallery">
<figure class="step"><figcaption><span>01</span> Customer logo</figcaption><div class="photos"><a href="/images/custom-projects/knife-logo.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/knife-logo.webp" alt="Folding utility knife: Customer logo" width="1080" height="760" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step wide"><figcaption><span>02</span> Logo placement and print artwork</figcaption><div class="photos"><a href="/images/custom-projects/knife-logo-placement.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/knife-logo-placement.webp" alt="Folding utility knife: Logo placement and print artwork — view 1" width="1007" height="459" loading="lazy" decoding="async" /></a><a href="/images/custom-projects/knife-print-artwork-front.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/knife-print-artwork-front.webp" alt="Folding utility knife: Logo placement and print artwork — view 2" width="608" height="950" loading="lazy" decoding="async" /></a><a href="/images/custom-projects/knife-print-artwork-back.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/knife-print-artwork-back.webp" alt="Folding utility knife: Logo placement and print artwork — view 3" width="608" height="950" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step"><figcaption><span>03</span> Design mockup</figcaption><div class="photos"><a href="/images/custom-projects/knife-design-mockup.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/knife-design-mockup.webp" alt="Folding utility knife: Design mockup" width="1086" height="1448" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step"><figcaption><span>04</span> Finished product</figcaption><div class="photos"><a href="/images/custom-projects/branded-folding-knife.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/branded-folding-knife.webp" alt="Folding utility knife: Finished product" width="1080" height="1454" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step"><figcaption><span>05</span> Color samples</figcaption><div class="photos"><a href="/images/custom-projects/knife-color-samples.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/knife-color-samples.webp" alt="Folding utility knife: Color samples" width="1672" height="941" loading="lazy" decoding="async" /></a></div></figure>
</div>
<details><summary>What to send for a similar project</summary><p>Share the base model or a reference photo, your logo, preferred colors, packaging format and estimated quantity. We review the configuration and confirm the minimum order and quotation for your project.</p></details></section>
<section class="case" id="development"><div class="lead"><div><span class="tag">New product development</span><h2>A gift tape measure developed from a customer concept</h2><p>The customer's concept guided the mold design. The project materials follow the work through tooling and sample measurement to a finished gift tape measure with a custom printed scale and box.</p><p class="next"><a href="/custom-tape-measure/">Explore custom tape measure options</a></p><p class="next"><a href="/blog/custom-tape-measure-development-case-study/">Read the tooling and sample development case study</a></p></div></div>
<div class="gallery">
<figure class="step"><figcaption><span>01</span> Customer concept</figcaption><div class="photos"><a href="/images/custom-projects/tape-concept.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/tape-concept.webp" alt="Gift tape measure: Customer concept" width="759" height="723" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step wide"><figcaption><span>02</span> Mold design</figcaption><div class="photos"><a href="/images/custom-projects/tape-mold-design-1.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/tape-mold-design-1.webp" alt="Gift tape measure: Mold design — view 1" width="1280" height="1243" loading="lazy" decoding="async" /></a><a href="/images/custom-projects/tape-mold-design-2.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/tape-mold-design-2.webp" alt="Gift tape measure: Mold design — view 2" width="630" height="611" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step wide"><figcaption><span>03</span> Mold making</figcaption><div class="photos"><a href="/images/custom-projects/tape-tooling-1.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/tape-tooling-1.webp" alt="Gift tape measure: Mold making — view 1" width="1800" height="1529" loading="lazy" decoding="async" /></a><a href="/images/custom-projects/tape-tooling-2.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/tape-tooling-2.webp" alt="Gift tape measure: Mold making — view 2" width="810" height="896" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step"><figcaption><span>04</span> Sample measurement</figcaption><div class="photos"><a href="/images/custom-projects/tape-sample-measurement.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/tape-sample-measurement.webp" alt="Gift tape measure: Sample measurement" width="1080" height="1141" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step"><figcaption><span>05</span> Custom packaging</figcaption><div class="photos"><a href="/images/custom-projects/tape-packaging.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/tape-packaging.webp" alt="Gift tape measure: Custom packaging" width="743" height="557" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step"><figcaption><span>06</span> Custom printed scale</figcaption><div class="photos"><a href="/images/custom-projects/tape-printed-scale.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/tape-printed-scale.webp" alt="Gift tape measure: Custom printed scale" width="743" height="557" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step"><figcaption><span>07</span> Finished product</figcaption><div class="photos"><a href="/images/custom-projects/gift-tape-measure.webp" target="_blank" rel="noopener"><img src="/images/custom-projects/gift-tape-measure.webp" alt="Gift tape measure: Finished product" width="743" height="557" loading="lazy" decoding="async" /></a></div></figure>
<figure class="step" style="grid-column:1/-1"><figcaption><span>08–09</span> Customer inspection and report</figcaption><div class="photos"><a href="/images/custom-projects/tape-inspection-redacted.webp" target="_blank" rel="noopener"><img style="height:auto;max-height:540px" src="/images/custom-projects/tape-inspection-redacted.webp" alt="Gift tape measure: Inspection photos alongside the inspection report, with customer details concealed" width="1800" height="1164" loading="lazy" decoding="async" /></a></div></figure>
</div>
<details><summary>What to send for a new product</summary><p>A sketch, reference sample or description is enough to start a discussion. Tell us the intended use, target market and expected quantity if known. We can then review the tooling and sampling needs with you.</p></details></section>
<div class="actions"><a href="/oem-odm/">Explore OEM and ODM services</a><a class="button button-primary" href="/request-quote/">Request a custom project quote</a></div>
</div>
</BaseLayout>
<style>
.project-story{width:min(1320px,92%);margin:auto;--ink:#202522;--muted:#59635d;--line:#d9dfd7;--accent:#ac400d}.tag{font-size:12px;font-weight:600;letter-spacing:.09em;text-transform:uppercase}
.intro{padding:clamp(30px,5vw,70px) 0 30px;display:grid;grid-template-columns:1.35fr 1fr;gap:5%;align-items:end}h1,h2,p,figure{margin:0}h1,h2{line-height:1.03;letter-spacing:-.045em;text-wrap:balance}h1{font-size:clamp(44px,6vw,86px);max-width:12ch}p{color:var(--muted);max-width:58ch}.intro p{font-size:18px}nav{display:flex;flex-wrap:wrap;gap:8px}nav a{background:var(--ink);color:white;border-radius:4px;padding:10px 17px;text-decoration:none}nav a:hover{background:var(--accent)}
.case{display:grid;grid-template-columns:minmax(200px,1fr) minmax(0,2.5fr);gap:18px 4%;border-top:2px solid var(--ink);padding:30px 0;margin-top:42px;scroll-margin-top:100px}.lead{align-self:start;position:sticky;top:100px}.tag{color:var(--accent)}h2{font-size:clamp(30px,3.5vw,50px);margin:12px 0 18px}.gallery{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:20px 12px;align-content:start}.step{grid-column:span 3;min-width:0;background:white;border:1px solid var(--line);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.step.wide{grid-column:span 4}#existing .step:first-child,#development .step:first-child,#development .step:nth-child(4){grid-column:span 2}#existing .step:nth-child(n+3){grid-column:span 2}
figcaption{display:flex;align-items:center;gap:10px;padding:10px 12px;font-weight:600;line-height:1.3;border-bottom:1px solid var(--line)}figcaption span{font-size:12px;font-weight:600;color:var(--accent)}.photos{display:flex;align-items:center;flex:1;gap:4px;padding:8px}.photos a{flex:1;min-width:0}.photos img{width:100%;height:clamp(155px,16vw,215px);display:block;object-fit:contain}.photos a:hover{outline:1px solid var(--accent)}a:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:2px}details{grid-column:2;background:#e9eee7;border-radius:4px;padding:14px 18px}summary{cursor:pointer;font-weight:650}details p{padding-top:10px}
@media(max-width:850px){.case,.intro{display:block}.lead{position:static;margin-bottom:20px}.intro p{margin-top:18px}details{margin-top:15px}}
@media(max-width:600px){.gallery{display:block}.step{margin-bottom:12px}.photos img{height:205px}.photos:has(a:nth-child(3)){flex-wrap:wrap}.photos:has(a:nth-child(3)) a:first-child{flex-basis:100%}.photos:has(a:nth-child(3)) img{height:156px}nav a{font-size:14px}.case{margin-top:28px;padding-top:20px}}


.next{margin-top:16px}.next a,.actions a:first-child{text-decoration:underline}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:24px;padding:0 0 40px}
</style>

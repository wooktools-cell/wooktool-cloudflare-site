---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import CompactRFQ from "../../components/CompactRFQ.astro";
import { site } from "../../siteData.js";
import { breadcrumbSchema } from "../../schema.js";

export async function getStaticPaths() {
  const postModules = import.meta.glob("../../cms/blog/*.md", { eager: true });
  return Object.entries(postModules).map(([path, post]) => {
    const slug = post.frontmatter.slug || path.split("/").pop().replace(/\.md$/, "");
    return {
      params: { slug },
      props: { post }
    };
  });
}

const { post } = Astro.props;
const { Content } = post;
const slug = post.frontmatter.slug || Astro.params.slug;
const path = `/blog/${slug}/`;
const rfqEnabled = Boolean(post.frontmatter.rfq);
const isCaseStudy = Boolean(post.frontmatter.caseStudy);
const hasProjectRfq = rfqEnabled && Boolean(post.frontmatter.rfqPrompt);
const relatedLinks = post.frontmatter.relatedLinks || [];
const blogSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.frontmatter.title,
    description: post.frontmatter.description,
    image: post.frontmatter.image ? new URL(post.frontmatter.image, site.domain).toString() : undefined,
    datePublished: post.frontmatter.date,
    dateModified: post.frontmatter.updated,
    author: {
      "@type": "Organization",
      name: "wooktools"
    },
    publisher: {
      "@type": "Organization",
      name: "wooktools",
      logo: {
        "@type": "ImageObject",
        url: new URL("/images/logo/wooktool-logo-new.webp", site.domain).toString()
      }
    },
    mainEntityOfPage: new URL(path, site.domain).toString()
  },
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog/" },
    { name: post.frontmatter.title, path }
  ])
];

// The visible article is the source of truth; keep Article and breadcrumb markup.
---

<BaseLayout
  title={post.frontmatter.seoTitle || post.frontmatter.title}
  description={post.frontmatter.description}
  path={path}
  image={post.frontmatter.image}
  type="article"
  schema={blogSchema}
>
  <section class="page-intro">
    <div>
      <p class="eyebrow">{post.frontmatter.date || (isCaseStudy ? "Case study" : "Blog")}</p>
      {post.frontmatter.updated && <p class="eyebrow">Updated <time datetime={post.frontmatter.updated}>{post.frontmatter.updated}</time></p>}
      <h1>{post.frontmatter.title}</h1>
      <p>{post.frontmatter.description}</p>
      {hasProjectRfq && (
        <a class="button button-primary case-rfq-link" href="#product-rfq" data-track="request_quote_click">
          {post.frontmatter.rfqTitle}
        </a>
      )}
    </div>
  </section>
  <article class="article">
    <Content />
  </article>
  {rfqEnabled && (
    <section class="section soft">
      <div class="section-inner">
        <CompactRFQ
          title={post.frontmatter.rfqTitle || "Request a Tape Measure Quote"}
          productInterest={post.frontmatter.rfqProduct || "Steel tape measure"}
          description={post.frontmatter.rfqPrompt}
          source={`blog-${slug}`}
        />
        {hasProjectRfq && (
          <p class="form-note">Have photos or drawings to attach? <a href={`mailto:${site.email}`} data-track="email_click">Email your project files</a>.</p>
        )}
      </div>
    </section>
  )}
  {relatedLinks.length > 0 && (
    <nav class="section compact-section" aria-labelledby="related-reading">
      <div class="section-inner">
        <h2 id="related-reading">Related sourcing guides</h2>
        <ul class="link-list">
          {relatedLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    </nav>
  )}
  {!hasProjectRfq && <CTA
    title="Need help with your sourcing project?"
    text="Send your RFQ with product photos, quantity, packaging direction, and target market. The wooktools team can help match suitable WOOKTOOL product options."
    primaryHref="/contact/#rfq-form"
    secondaryLabel="View Buyer Guides"
    secondaryHref="/buyer-guides/"
  />}
</BaseLayout>

<style>
  .case-rfq-link {
    margin-top: 1rem;
  }

  .article :global(.case-blog-figure) {
    margin: 1.5rem 0 2rem;
  }

  .article :global(.case-blog-figure img) {
    max-height: 30rem;
    object-fit: contain;
    margin: 0;
  }

  .article :global(.case-blog-figure figcaption) {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  :global(#product-rfq) {
    scroll-margin-top: 7rem;
  }
</style>
